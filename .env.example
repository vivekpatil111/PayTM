PORT=5000

# Google Gemini API Key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cognee Knowledge Graph SDK — get from https://cognee.ai
COGNEE_API_KEY=your_cognee_api_key_here

# DeepSeek API Key (primary LLM for AI chat) — get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (optional fallback) — get from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# n8n Webhook URL — replace with your own n8n instance webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/disburse
